<?xml version='1.0' encoding='UTF-8'?>

<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<!-- Get approved files list -->
	<bean id="webscript.com.acibfunin.get_approved_files_list.get"
          class="com.acibfunin.webscripts.GetApprovedFilesList" parent="webscript">
		<property name="serviceRegistry" ref="ServiceRegistry"/>
		<property name="sysAdminParams" ref="sysAdminParams"/>
        <property name="taskShareUrl" value="${task.share.url}"/>
	</bean>
	
	<!-- Get CSV of approved files -->
	<bean id="webscript.com.acibfunin.export_approved_files_to_csv.get"
          class="com.acibfunin.webscripts.ExportApprovedFilesToCSV" parent="webscript">
		<property name="serviceRegistry" ref="ServiceRegistry"/>
		<property name="sysAdminParams" ref="sysAdminParams"/>
        <property name="taskShareUrl" value="${task.share.url}"/>
	</bean>

	<!-- Get workflow task info -->
	<bean id="webscript.com.acibfunin.get_task_info.get"
          class="com.acibfunin.webscripts.GetTaskInfo" parent="webscript">
        <property name="serviceRegistry" ref="ServiceRegistry"/>
        <property name="sysAdminParams" ref="sysAdminParams"/>
		<property name="workflowService" ref="WorkflowService"/>
        <property name="taskShareUrl" value="${task.share.url}"/>
	</bean>

    <!-- List deleted documents (trashcan) -->
    <bean id="webscript.com.acibfunin.list_deleted_documents.get"
          class="com.acibfunin.webscripts.ListDeletedDocuments" parent="webscript">
        <property name="serviceRegistry" ref="ServiceRegistry"/>
    </bean>

    <bean id="webscript.com.acibfunin.remove-version.post" class="com.acibfunin.webscripts.RemoveVersion" parent="webscript">
        <property name="serviceRegistry" ref="ServiceRegistry" />
    </bean>

    <bean id="webscript.com.acibfunin.copy.post"
          class="com.acibfunin.webscripts.ReplaceCurrentVersionContentWebScript"
          parent="webscript">
        <property name="nodeService" ref="NodeService" />
        <property name="contentService" ref="ContentService" />
        <property name="versionService" ref="VersionService" />
        <property name="copyService" ref="CopyService" />
    </bean>

</beans>
